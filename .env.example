# Servidor e armazenamento persistente (padrões abaixo).
PORT=3005
DATA_DIR=./data
NODE_ENV=development
# Defina um segredo aleatório em produção, fora do versionamento.
# Se vazio, a aplicação usa o segredo persistido em disco.
SECRET=

# URL pública HTTPS da aplicação (localhost é permitido para desenvolvimento).
APP_URL=http://localhost:3005
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
# Deve corresponder ao ambiente da chave e do webhook. Produção: false.
ABACATEPAY_DEV_MODE=true
